\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Noise sensitivity: invariant space is MORE robust.} \textit  {Left}: Same Gaussian noise $\sigma $ applied to invariants (green) vs raw action deltas (red). Invariants consistently produce less trajectory error. \textit  {Right}: Ratio $<1$ at every noise level --- invariant-space prediction errors are \textbf  {40--52\% less damaging} than raw-action errors.}}{9}{figure.5}\protected@file@percent }
\newlabel{fig:sensitivity}{{5}{9}{\textbf {Noise sensitivity: invariant space is MORE robust.} \textit {Left}: Same Gaussian noise $\sigma $ applied to invariants (green) vs raw action deltas (red). Invariants consistently produce less trajectory error. \textit {Right}: Ratio $<1$ at every noise level --- invariant-space prediction errors are \textbf {40--52\% less damaging} than raw-action errors}{figure.5}{}}
\newlabel{fig:sensitivity@cref}{{[figure][5][]5}{[1][8][]9}{}{}{}}
