\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Obstacle-aware adaptation: DHB-XR vs affine (same start/goal).} \textit  {Left}: \textsc  {DHB-XR}{} decodes the invariant shape, then iteratively projects waypoints above the obstacle (simulating Fatrop inequality constraints) --- 0 collisions, goal reached exactly. Dotted green: DHB before constraint (also clips). \textit  {Right}: Affine rotation ($-15^\circ $ Y-tilt) has no mechanism for obstacle avoidance --- 9 trajectory points collide with the wall. RGB triads show 6-DOF orientation. The obstacle (wall top $z{=}0.52\,\text  {m}$, only $3\,\text  {cm}$ clearance from original arc peak) is included in \textsc  {DHB-XR}{}'s optimization but invisible to affine.}}{10}{figure.6}\protected@file@percent }
\newlabel{fig:adaptation_comparison}{{6}{10}{\textbf {Obstacle-aware adaptation: DHB-XR vs affine (same start/goal).} \textit {Left}: \dhb {} decodes the invariant shape, then iteratively projects waypoints above the obstacle (simulating Fatrop inequality constraints) --- 0 collisions, goal reached exactly. Dotted green: DHB before constraint (also clips). \textit {Right}: Affine rotation ($-15^\circ $ Y-tilt) has no mechanism for obstacle avoidance --- 9 trajectory points collide with the wall. RGB triads show 6-DOF orientation. The obstacle (wall top $z{=}0.52\,\text {m}$, only $3\,\text {cm}$ clearance from original arc peak) is included in \dhb {}'s optimization but invisible to affine}{figure.6}{}}
\newlabel{fig:adaptation_comparison@cref}{{[figure][6][]6}{[1][8][]10}{}{}{}}
